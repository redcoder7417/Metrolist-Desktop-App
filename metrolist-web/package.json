{
  "name": "metrolist-web",
  "version": "14.0.0",
  "private": true,
  "description": "Metrolist Web UI and local API server",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetrolistGroup/Metrolist.git"
  },
  "homepage": "https://github.com/MetrolistGroup/Metrolist#readme",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run electron:dev",
    "electron": "npm run electron:dev",
    "electron:dev": "cross-env NODE_ENV=development concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.metrolist.app",
    "productName": "Metrolist",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release-new/v14.0.0"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/build/libs/metrolist-web-backend-14.0.0-all.jar",
        "to": "backend.jar"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Metrolist",
      "license": "build/license.txt",
      "runAfterFinish": true
    }
  }
}
